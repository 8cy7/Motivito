# ========================
# قاعدة البيانات
# ========================
DATABASE_URL="postgresql://user:password@localhost:5432/motivito"
REDIS_URL="redis://localhost:6379"

# ========================
# JWT
# ========================
JWT_SECRET="super-secret-key-min-32-chars-change-this"
JWT_REFRESH_SECRET="another-super-secret-key-change-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ========================
# APNs (Apple Push Notifications)
# ========================
APNS_KEY_ID="XXXXXXXXXX"
APNS_TEAM_ID="XXXXXXXXXX"
APNS_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAgEA...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID="org.reactjs.native.example.AmazingMotivito"

# ========================
# Firebase FCM (legacy - not used)
# ========================
FIREBASE_PROJECT_ID="motivito-app"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@motivito-app.iam.gserviceaccount.com"

# ========================
# Cloudflare R2 (صور الأفاتار)
# ========================
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="motivito-avatars"
R2_PUBLIC_URL="https://avatars.motivito.app"

# ========================
# Google Gemini AI
# ========================
GEMINI_API_KEY="AIza..."

# ========================
# Tap Payments (السعودية)
# ========================
TAP_SECRET_KEY="sk_live_..."
TAP_WEBHOOK_SECRET="your-webhook-secret"
SUBSCRIPTION_PRICE_SAR=14.99

# ========================
# Resend (البريد الإلكتروني)
# ========================
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@motivito.app"

# ========================
# التطبيق
# ========================
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
CORS_ORIGINS="motivito://,http://localhost:3000"
